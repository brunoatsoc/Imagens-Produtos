# Database provider: oracle or odbc
DB_PROVIDER=oracle

# Oracle connection
DB_USER=
DB_PASSWORD=
DB_DSN=localhost:1521/XE
DB_CLIENT_LIB_DIR=
DB_CONNECT_TIMEOUT=30

# ODBC connection, used only when DB_PROVIDER=odbc
ODBC_CONNECTION_STRING=

# Client database objects
TABELA_OFERTAS=WSOFERTASATIVAS
COLUNA_CODIGO_OFERTA=
COLUNA_DESCRICAO_OFERTA=

# Batch size for product queries
PRODUTOS_POR_LOTE=100

# Final image size
LARGURA_FINAL_PX=
ALTURA_FINAL_PX=

# Local folder where downloaded images are stored and managed
# Relative paths are resolved from the script/executable folder
PASTA_SAIDA=C:\Users\seu-usuario\Downloads

# Local image management server
PORTA_SERVIDOR_GERENCIAMENTO=8000
